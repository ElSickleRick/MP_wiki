Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"integrant", ",", " ", "I"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"integrant", "[", 
    RowBox[{"x", ",", "y"}], "]"}], " ", "=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", "y", "]"}], "^", "2"}], "+", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"y", "-", 
        RowBox[{"x", "/", "2"}]}], "]"}], "^", "2"}], "+", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"x", "/", "2"}], "]"}], "^", "2"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"I", " ", "=", " ", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "Pi"}], ")"}], "^", "2"}], ")"}]}], "*", 
   RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"integrant", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "Pi"}], ",", " ", "Pi"}], "}"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<SymbolicDomainDecomposition\>\"", ",", "\[IndentingNewLine]", 
        RowBox[{"Method", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
           RowBox[{"\"\<MaxErrorIncreases\>\"", "->", " ", "4000"}]}], 
          "}"}]}]}], "}"}]}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{"MaxRecursion", " ", "->", " ", "20"}]}], "]"}]}]}]}], "Input",
