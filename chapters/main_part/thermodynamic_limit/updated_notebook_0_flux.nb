Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "mu", ",", " ", "beta", ",", " ", "dispersion", ",", " ", "fermi", ",", " ",
    "PN", ",", " ", "chi"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"beta", " ", "=", " ", "200"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dispersion", "[", 
    RowBox[{"x", ",", "y", ",", 
     RowBox[{"mu_", "?", "NumericQ"}]}], "]"}], ":=", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cos", "[", "x", "]"}], "+", 
        RowBox[{"Cos", "[", "y", "]"}], " ", "+", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"x", "-", "y"}], "]"}]}], ")"}]}], "+", "mu"}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fermi", "[", 
     RowBox[{"x", ",", "y", ",", 
      RowBox[{"mu_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"beta", "*", 
         RowBox[{"dispersion", "[", 
          RowBox[{"x", ",", "y", ",", "mu"}], "]"}]}], "]"}], "+", "1"}], 
      ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PN", "[", 
     RowBox[{"mu_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"2", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "Pi"}], ")"}], "^", "2"}], ")"}]}], "*", 
     RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fermi", "[", 
        RowBox[{"x", ",", "y", ",", "mu"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "Pi"}], ",", " ", "Pi"}], "}"}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<SymbolicDomainDecomposition\>\"", ",", "\[IndentingNewLine]", 
          RowBox[{"Method", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
             RowBox[{"\"\<MaxErrorIncreases\>\"", "->", " ", "4000"}]}], 
            "}"}]}]}], "}"}]}], ",", " ", "\[IndentingNewLine]", 
       RowBox[{"MaxRecursion", " ", "->", " ", "20"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"chi", "[", 
    RowBox[{"mu_", "?", "NumericQ"}], "]"}], " ", ":=", "  ", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "Pi"}], ")"}], "^", "2"}], ")"}]}], "*", 
    RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"I", "*", 
         RowBox[{"(", 
          RowBox[{"y", "-", "x"}], ")"}]}], "]"}], 
       RowBox[{"fermi", "[", 
        RowBox[{"x", ",", "y", ",", "mu"}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"-", "Pi"}], ",", " ", "Pi"}], "}"}], ",", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{
        "\"\<SymbolicDomainDecomposition\>\"", ",", "\[IndentingNewLine]", 
         RowBox[{"Method", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
            RowBox[{"\"\<MaxErrorIncreases\>\"", "->", " ", "4000"}]}], 
           "}"}]}]}], "}"}]}], ",", " ", "\[IndentingNewLine]", 
      RowBox[{"MaxRecursion", " ", "->", " ", "20"}]}], "]"}]}]}], 
  ";"}]}], "Input",
