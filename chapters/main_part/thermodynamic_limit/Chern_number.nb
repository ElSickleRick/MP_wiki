      RowBox[{"x", ",", 
       RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "Pi"}], ",", " ", "Pi"}], "}"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<SymbolicDomainDecomposition\>\"", ",", "\[IndentingNewLine]", 
        RowBox[{"Method", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
           RowBox[{"\"\<MaxErrorIncreases\>\"", "->", " ", "4000"}]}], 
          "}"}]}]}], "}"}]}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{"MaxRecursion", " ", "->", " ", "20"}]}], "]"}]}], 
